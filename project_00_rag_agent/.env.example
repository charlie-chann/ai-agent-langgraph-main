# 部署环境：local | test | prod
# 优先加载 .env.{APP_ENV}，再兼容本文件 .env
# 推荐：cp .env.local.example .env.local  （本地）
#       cp .env.test.example .env.test    （测试）
#       cp .env.prod.example .env.prod    （生产，勿提交）
APP_ENV=local

# LLM Provider: ollama | openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

# OpenAI-compatible (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
KG_ENABLED=true

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=60
DEMO_USERS_JSON={"admin":"admin123:admin","editor":"editor123:editor","viewer":"viewer123:viewer"}

# Redis (cache + rate limit; falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# HITL / Checkpointer + Conversations (PostgreSQL)
HITL_ENABLED=true
HITL_RISK_KEYWORDS=delete,drop,truncate,password,secret
CHECKPOINTER_BACKEND=memory
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_checkpoint
# auto=优先 Postgres；sqlite=本地文件（无 Postgres 时）
CONVERSATIONS_BACKEND=auto

# KG extraction: rule | llm | hybrid  （本地开发建议 rule，hybrid 较慢）
KG_EXTRACTION_MODE=rule

# UI
API_BASE_URL=http://localhost:8000

# Model routing: aux (guard/rewrite/grade) vs generate
MODEL_ROUTING_ENABLED=true
OLLAMA_AUX_MODEL=qwen2.5:1.5b
# OLLAMA_GENERATE_MODEL=qwen2.5:7b
OPENAI_AUX_MODEL=gpt-4o-mini
# OPENAI_GENERATE_MODEL=gpt-4o

# SSE stream resume (WAL + Last-Event-ID)
STREAM_RESUME_ENABLED=true
STREAM_WAL_TTL_SECONDS=3600
STREAM_FLUSH_CHARS=12
STREAM_FLUSH_INTERVAL_MS=40
STREAM_RESUME_POLL_SECONDS=120
STREAM_CANCEL_ON_DISCONNECT=false

# Observability
# LANGSMITH_API_KEY=
