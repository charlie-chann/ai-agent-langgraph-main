# LLM Provider: ollama | openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

# OpenAI-compatible (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
KG_ENABLED=true

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=60
DEMO_USERS_JSON={"admin":"admin123:admin","editor":"editor123:editor","viewer":"viewer123:viewer"}

# Redis (cache + rate limit; falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# HITL + Postgres checkpointer
HITL_ENABLED=true
HITL_RISK_KEYWORDS=delete,drop,truncate,password,secret
CHECKPOINTER_BACKEND=memory
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_checkpoint

# KG extraction: rule | llm | hybrid  （本地开发建议 rule，hybrid 较慢）
KG_EXTRACTION_MODE=rule

# UI
API_BASE_URL=http://localhost:8000

# Observability
# LANGSMITH_API_KEY=
