# 生产环境（APP_ENV=prod）
# 用法（生产机 / 编排系统）：
#   cp .env.prod.example .env.prod
#   # 填入真实密钥与地址；.env.prod 不要提交 Git
#   export APP_ENV=prod
#   uvicorn main:app --host 0.0.0.0 --port 8000
#
# 护栏：JWT_SECRET 若为默认弱密钥或长度 < 32，进程启动会失败。

APP_ENV=prod

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

# 如改用云端模型：
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
KG_ENABLED=true
KG_EXTRACTION_MODE=hybrid

# 【必改】强随机密钥，长度 >= 32，且勿与测试/本地相同
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=60
# 【必改】生产账号与强密码
DEMO_USERS_JSON={"admin":"REPLACE_STRONG_PASSWORD:admin"}

REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
CACHE_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

HITL_ENABLED=true
CHECKPOINTER_BACKEND=postgres
CONVERSATIONS_BACKEND=postgres
DATABASE_URL=postgresql://rag:REPLACE_DB_PASSWORD@postgres:5432/rag_checkpoint

# 正式域名（Java 生产配置应对齐此地址）
API_BASE_URL=https://rag.example.com
API_PORT=8000

MODEL_ROUTING_ENABLED=true
STREAM_RESUME_ENABLED=true

# LANGSMITH_API_KEY=
