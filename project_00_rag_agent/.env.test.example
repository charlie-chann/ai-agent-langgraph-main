# 测试 / 预发环境（APP_ENV=test）
# 用法（测试机）：
#   cp .env.test.example .env.test
#   # 改成真实测试域名、库地址、密钥
#   export APP_ENV=test
#   uvicorn main:app --host 0.0.0.0 --port 8000
#
# Java 测试后端应配置：rag.api-base-url = 下面的 API_BASE_URL

APP_ENV=test

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
KG_ENABLED=true
KG_EXTRACTION_MODE=rule

# 测试环境请使用独立密钥（勿与生产相同）
JWT_SECRET=test-only-secret-not-for-prod-change-me-32chars
JWT_EXPIRE_MINUTES=60
DEMO_USERS_JSON={"admin":"admin123:admin","editor":"editor123:editor","viewer":"viewer123:viewer"}

# 测试专用 Redis / DB（与生产隔离）
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

HITL_ENABLED=true
CHECKPOINTER_BACKEND=postgres
CONVERSATIONS_BACKEND=postgres
DATABASE_URL=postgresql://rag:rag@postgres:5432/rag_checkpoint_test

# 改成你们的测试域名，供 UI / Java 客户端使用
API_BASE_URL=https://rag-test.example.com
API_PORT=8000

MODEL_ROUTING_ENABLED=true
STREAM_RESUME_ENABLED=true
