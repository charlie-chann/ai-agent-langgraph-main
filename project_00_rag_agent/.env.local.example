# 本地开发环境（APP_ENV=local）
# 用法：
#   cp .env.local.example .env.local
#   # 可选：export APP_ENV=local
#   uvicorn main:app --reload

APP_ENV=local

# LLM
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
KG_ENABLED=true
KG_EXTRACTION_MODE=rule

# Auth（本地可用演示账号）
JWT_SECRET=local-dev-only-secret-not-for-prod
JWT_EXPIRE_MINUTES=60
DEMO_USERS_JSON={"admin":"admin123:admin","editor":"editor123:editor","viewer":"viewer123:viewer"}

# Redis（没有也可启动，自动降级内存）
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# 本地可用 memory/sqlite，不必强依赖 Postgres
HITL_ENABLED=true
CHECKPOINTER_BACKEND=memory
CONVERSATIONS_BACKEND=sqlite
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_checkpoint

API_BASE_URL=http://localhost:8000
API_PORT=8000

MODEL_ROUTING_ENABLED=true
OLLAMA_AUX_MODEL=qwen2.5:1.5b
STREAM_RESUME_ENABLED=true
